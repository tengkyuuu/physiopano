{
  "$name": "PHYSIOPAÑO Wayfinding",
  "$description": "Single source of truth for the Flutter app and the React care console. Support is a route, not a verdict.",
  "color": {
    "light": {
      "ground":      "#EEF0EC",
      "surface":     "#FBFBF8",
      "surfaceSunk": "#E3E7E2",
      "panel":       "#0E2A2B",
      "onPanel":     "#F3F6F2",
      "ink":         "#10201F",
      "inkMuted":    "#4A5A58",
      "line":        "#C9D0CC",
      "focus":       "#1F6FB2"
    },
    "dark": {
      "ground":      "#0B1A1B",
      "surface":     "#12292A",
      "surfaceSunk": "#081314",
      "panel":       "#071415",
      "onPanel":     "#F3F6F2",
      "ink":         "#E8EDEA",
      "inkMuted":    "#A3B3B0",
      "line":        "#2A403F",
      "focus":       "#5FA4E0"
    },
    "route": {
      "$comment": "The stepped support ladder. Each station ALSO carries a number and pictogram; never colour alone.",
      "light": {
        "selfHelp":   "#0F7A68",
        "community":  "#1F6FB2",
        "primaryCare":"#B07D0F",
        "teleMH":     "#5D4BA6",
        "specialist": "#34495E"
      },
      "dark": {
        "selfHelp":   "#3FB59D",
        "community":  "#5FA4E0",
        "primaryCare":"#E3B04B",
        "teleMH":     "#9C8BE6",
        "specialist": "#8FA6BA"
      }
    },
    "crisis": { "light": "#C63B2B", "dark": "#EF6A57", "$comment": "Reserved. Only crisis/urgent-risk UI may use it." },
    "brand":  { "light": "#0F7A68", "dark": "#3FB59D", "$comment": "= route.selfHelp. Your own lane + primary actions." }
  },
  "font": {
    "display": "Overpass",
    "text":    "Overpass",
    "arabic":  "Noto Kufi Arabic",
    "data":    "Overpass Mono",
    "$comment": "Overpass descends from Highway Gothic signage lettering. Mono only for sensor readings and IDs."
  },
  "type": {
    "caption": { "size": 12, "line": 16, "weight": 600, "tracking": 0.06, "case": "upper" },
    "small":   { "size": 14, "line": 20, "weight": 400 },
    "body":    { "size": 16, "line": 24, "weight": 400 },
    "lead":    { "size": 20, "line": 28, "weight": 600 },
    "title":   { "size": 24, "line": 30, "weight": 700 },
    "heading": { "size": 32, "line": 36, "weight": 800, "tracking": -0.01 },
    "display": { "size": 44, "line": 46, "weight": 800, "tracking": -0.02 },
    "sign":    { "size": 64, "line": 64, "weight": 800, "tracking": -0.03 }
  },
  "space":  { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "radius": { "control": 6, "panel": 12, "sheet": 20, "pill": 999 },
  "elevation": {
    "raised":  "0 1px 2px rgba(14,42,43,.08), 0 2px 8px rgba(14,42,43,.06)",
    "overlay": "0 8px 24px rgba(14,42,43,.16)"
  },
  "line": {
    "$comment": "State is carried by line FORM, not hue.",
    "live":    { "width": 3, "dash": null,   "height": "full" },
    "pending": { "width": 3, "dash": [6, 4], "height": "full" },
    "stale":   { "width": 3, "dash": null,   "height": "half" },
    "baselineBand": { "fillOpacity": 0.14 }
  },
  "deviation": {
    "$comment": "Fixed size ramp for 'how far from YOUR baseline'. Size, not colour.",
    "within":  { "z": "<1",   "marker": 8 },
    "notable": { "z": "1-2",  "marker": 14 },
    "marked":  { "z": ">2",   "marker": 20 }
  },
  "motion": {
    "fast": 140, "base": 220, "slow": 360,
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "$comment": "One authored moment: the 'you are here' marker slides along the lane. Respect reduced motion."
  },
  "touch": { "min": 48 }
}
